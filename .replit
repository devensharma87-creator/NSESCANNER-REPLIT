modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
# PHASE 0.8T — PREPARED, NOT ACTIVE. This value takes effect only when the
# owner publishes; the existing production deployment keeps running Autoscale
# until then. Reserved VM ("vm") is required because a live Kite feed needs
# exactly one always-on process: Autoscale may run concurrent replicas and
# scales to zero, so no process can be the sole holder of the provider socket
# budget. Machine size is chosen in the Publishing UI, not here.
# Rollback: set this back to "autoscale" and republish.
# Runbook: docs/PHASE_0_8T_RESERVED_VM_TOPOLOGY_RUNBOOK.md
deploymentTarget = "vm"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
REASONING_WRITER_V2_ENABLED = "1"

[userenv.development]
KITE_MIRROR_URL = "https://marketscannerbydev.in"
PAPER_FO_SHADOW_EXITS_ENABLED = "1"

[userenv.production]
PAPER_TRADING_ENABLED = "false"
LIVE_CASH_SWING_ORDER_ENABLED = "false"
SWING_CASH_EXECUTION_MODE = "paper_only"

[nix]
channel = "stable-25_05"
packages = ["glibcLocales"]
