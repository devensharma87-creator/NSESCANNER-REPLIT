modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
REASONING_WRITER_V2_ENABLED = "1"

[userenv.development]
KITE_MIRROR_URL = "https://marketscannerbydev.in"
PAPER_FO_SHADOW_EXITS_ENABLED = "1"
VITE_PREVIEW_BYPASS = "true"

[userenv.production]
PAPER_TRADING_ENABLED = "false"
LIVE_CASH_SWING_ORDER_ENABLED = "false"
SWING_CASH_EXECUTION_MODE = "paper_only"

[nix]
channel = "stable-25_05"
packages = ["glibcLocales"]
