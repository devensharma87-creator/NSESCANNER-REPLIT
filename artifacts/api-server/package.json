{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx src/test-infra/dbTestPreflightRunner.ts",
    "test:unit": "vitest run --config vitest.config.unit.ts --pool=threads",
    "test:full": "vitest run --config vitest.config.ts --pool=threads",
    "test:tripwire": "tsx src/test-infra/tripwireHarness.ts",
    "test:db": "tsx src/test-infra/dbTestPreflightRunner.ts",
    "backfill:swing-sector": "tsx ./src/scripts/backfill-swing-sector.ts",
    "rotate:kite-key": "tsx ./src/scripts/rotateKiteTokenEncKey.ts",
    "fetch:index-candles": "tsx ./src/scripts/fetchKiteIndexCandles.ts"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/indicators": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-rate-limit": "^8.4.0",
    "helmet": "^8.1.0",
    "kiteconnect": "^5.2.0",
    "pino": "^9",
    "pino-http": "^10",
    "yahoo-finance2": "^3.14.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0",
    "tsx": "catalog:",
    "vitest": "^4.1.5"
  }
}
