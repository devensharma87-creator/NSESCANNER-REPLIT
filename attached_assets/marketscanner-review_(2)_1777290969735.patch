-/** Compute the next 06:00 IST timestamp after `from`. Kite tokens die there. */
+/**
+ * Compute the next 06:00 IST timestamp strictly after `from`.
+ *
+ * Zerodha invalidates the access_token at ~06:00 IST every morning, so this
+ * is the natural ceiling on token validity. We use `Intl.DateTimeFormat`
+ * (timeZone: "Asia/Kolkata") to read out the IST wall-clock for `from`,
+ * then pick today's 06:00 IST or tomorrow's depending on whether we've
+ * already passed it.
+ *
+ * Why this implementation:
+ *   - The previous version added 5.5 hours to UTC to "construct" IST. That
+ *     works only because India has had no DST since 1945 — historically
+ *     correct for this app, but the pattern is brittle (it would silently
+ *     break the moment any DST/offset change happened, and it's hard to
+ *     read for anyone debugging time bugs).
+ *   - This version asks the runtime to do the timezone conversion the
+ *     correct way and is unit-testable for boundary cases.
+ *
+ * Boundary semantics:
+ *   - At 06:00:00.000 IST exactly → returns TOMORROW's 06:00 IST. The token
+ *     expiring at this moment is no longer trustworthy, so we never emit
+ *     an `expiresAt` that equals "right now" — the function rolls forward.
+ */
 function next6amIST(from: Date = new Date()): Date {
-  const istNow = new Date(from.getTime() + 5.5 * 3600 * 1000);
-  const y = istNow.getUTCFullYear();
-  const m = istNow.getUTCMonth();
-  const d = istNow.getUTCDate();
-  const h = istNow.getUTCHours();
-  // 06:00 IST = 00:30 UTC of the same calendar day
-  let target = new Date(Date.UTC(y, m, d, 0, 30, 0));
-  if (h >= 6) target = new Date(target.getTime() + 24 * 3600 * 1000);
+  // Resolve `from` to the IST wall-clock components we need.
+  const fmt = new Intl.DateTimeFormat("en-GB", {
+    timeZone: "Asia/Kolkata",
+    year: "numeric", month: "2-digit", day: "2-digit",
+    hour: "2-digit", minute: "2-digit", second: "2-digit",
+    hour12: false,
+  });
+  const parts = Object.fromEntries(
+    fmt.formatToParts(from).map((p) => [p.type, p.value]),
+  ) as Record<string, string>;
+  const year = parseInt(parts["year"]!, 10);
+  const month = parseInt(parts["month"]!, 10);   // 1-12 from Intl
+  const day = parseInt(parts["day"]!, 10);
+  const hour = parseInt(parts["hour"]!, 10);
+  const minute = parseInt(parts["minute"]!, 10);
+  const second = parseInt(parts["second"]!, 10);
+
+  // 06:00 IST = 00:30 UTC. Build a candidate UTC instant for "today's 06:00 IST".
+  const todaySixIstUtc = Date.UTC(year, month - 1, day, 0, 30, 0, 0);
+
+  // Have we already reached or passed 06:00 IST today?
+  const istHasReachedSix =
+    hour > 6 ||
+    (hour === 6 && (minute > 0 || second > 0)) ||
+    hour === 6;
+  // Note: at exactly 06:00:00 IST, `istHasReachedSix` is true → roll forward
+  // by one day so the returned Date is strictly in the future.
+
+  const target = new Date(istHasReachedSix ? todaySixIstUtc + 24 * 3600 * 1000 : todaySixIstUtc);
   return target;
 }
 
+// Exposed for unit tests.
+export const __testing = { next6amIST };
