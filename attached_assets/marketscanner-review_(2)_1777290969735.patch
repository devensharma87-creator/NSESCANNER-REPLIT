+const PRICE_EPS = 0.05;
+const GREEK_EPS = 1e-3;
+const IV_EPS = 5e-3;
+
+describe("priceAndGreeks", () => {
+  describe("ATM call/put parity", () => {
+    it("call and put prices satisfy put-call parity at ATM", () => {
+      // Standard parity: C - P = S·e^(-qT) - K·e^(-rT)
+      const inp = { S: 100, K: 100, T: 0.5, r: 0.05, q: 0.02, sigma: 0.2 };
+      const c = priceAndGreeks({ ...inp, type: "CE" }).price;
+      const p = priceAndGreeks({ ...inp, type: "PE" }).price;
+      const parity = inp.S * Math.exp(-inp.q * inp.T) - inp.K * Math.exp(-inp.r * inp.T);
+      expect(c - p).toBeCloseTo(parity, 4);
+    });
+
+    it("call delta + |put delta| = e^(-qT)", () => {
+      // delta_C - delta_P = e^(-qT) (with q=0, this is just 1).
+      const inp = { S: 100, K: 100, T: 0.5, r: 0.05, q: 0.02, sigma: 0.2 };
+      const c = priceAndGreeks({ ...inp, type: "CE" }).delta;
+      const p = priceAndGreeks({ ...inp, type: "PE" }).delta;
+      expect(c - p).toBeCloseTo(Math.exp(-inp.q * inp.T), 4);
+    });
+  });
+
+  describe("Hull textbook examples", () => {
+    it("Hull example: S=42, K=40, r=10%, σ=20%, T=0.5 → C ≈ 4.76", () => {
+      // Hull 9e, Example 15.6: European call with no dividends.
+      const r = priceAndGreeks({ S: 42, K: 40, T: 0.5, r: 0.1, q: 0, sigma: 0.2, type: "CE" });
+      expect(r.price).toBeCloseTo(4.7594, 2);
+      // delta should be near 0.78
+      expect(r.delta).toBeGreaterThan(0.77);
+      expect(r.delta).toBeLessThan(0.79);
+    });
+
+    it("ATM call with σ=20%, T=1y, r=5%, q=0 prices to ~10.45", () => {
+      // Standard textbook ATM call value.
+      const r = priceAndGreeks({ S: 100, K: 100, T: 1, r: 0.05, q: 0, sigma: 0.2, type: "CE" });
