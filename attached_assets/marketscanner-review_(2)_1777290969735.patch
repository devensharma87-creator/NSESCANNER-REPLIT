+import { describe, it, expect } from "vitest";
+import { __testing, computeOiInsights } from "./oiLab";
+import type { OcResponse, OcRow } from "./optionChain";
+
+const { classifyBuildup, scoreSentiment, bandFromScore } = __testing;
+
+/**
+ * Tests for OI Lab's pure helpers.
+ *
+ * The fetch/persist paths require a live Kite session and disk, so they're
+ * out of scope for unit tests; everything here is deterministic math.
+ */
+
+// ─── classifyBuildup ────────────────────────────────────────────────────────
+
+describe("classifyBuildup", () => {
+  // Standard four-quadrant truth table:
+  //   price↑ + OI↑ → LONG_BUILDUP   (fresh longs)
+  //   price↓ + OI↑ → SHORT_BUILDUP  (fresh shorts)
+  //   price↑ + OI↓ → SHORT_COVERING (shorts closing)
+  //   price↓ + OI↓ → LONG_UNWINDING (longs closing)
+
+  it("price↑ OI↑ → LONG_BUILDUP", () => {
+    expect(classifyBuildup(2, 5)).toBe("LONG_BUILDUP");
+  });
+  it("price↓ OI↑ → SHORT_BUILDUP", () => {
+    expect(classifyBuildup(-2, 5)).toBe("SHORT_BUILDUP");
+  });
+  it("price↑ OI↓ → SHORT_COVERING", () => {
+    expect(classifyBuildup(2, -5)).toBe("SHORT_COVERING");
+  });
+  it("price↓ OI↓ → LONG_UNWINDING", () => {
+    expect(classifyBuildup(-2, -5)).toBe("LONG_UNWINDING");
+  });
+
+  it("flat OI (|Δ| < 0.5%) → NEUTRAL regardless of price move", () => {
+    expect(classifyBuildup(5, 0.4)).toBe("NEUTRAL");
+    expect(classifyBuildup(-5, -0.4)).toBe("NEUTRAL");
+    expect(classifyBuildup(0, 0)).toBe("NEUTRAL");
+  });
+
+  it("flat price (|Δ| < 0.1%) → NEUTRAL even with OI movement", () => {
+    expect(classifyBuildup(0.05, 5)).toBe("NEUTRAL");
+    expect(classifyBuildup(-0.05, -5)).toBe("NEUTRAL");
+  });
+
+  it("threshold boundary: priceΔ exactly 0.1%, OIΔ above threshold → not NEUTRAL", () => {
+    // 0.1 < 0.1 is false → not in the flat-price band; classifies normally.
+    expect(classifyBuildup(0.1, 1)).not.toBe("NEUTRAL");
+  });
+});
+
+// ─── bandFromScore ──────────────────────────────────────────────────────────
+
+describe("bandFromScore", () => {
+  it("score = -100 → STRONGLY_BEARISH", () => {
+    expect(bandFromScore(-100).band).toBe("STRONGLY_BEARISH");
+  });
+  it("score = -60 (lower edge) → STRONGLY_BEARISH", () => {
+    expect(bandFromScore(-60).band).toBe("STRONGLY_BEARISH");
+  });
+  it("score = -59 → MILDLY_BEARISH", () => {
+    expect(bandFromScore(-59).band).toBe("MILDLY_BEARISH");
+  });
+  it("score = -20 (band edge) → MILDLY_BEARISH", () => {
+    expect(bandFromScore(-20).band).toBe("MILDLY_BEARISH");
+  });
+  it("score = 0 → NEUTRAL", () => {
+    expect(bandFromScore(0).band).toBe("NEUTRAL");
+  });
+  it("score = 19 → NEUTRAL (just below the bullish edge)", () => {
+    expect(bandFromScore(19).band).toBe("NEUTRAL");
+  });
+  it("score = 20 → MILDLY_BULLISH", () => {
+    expect(bandFromScore(20).band).toBe("MILDLY_BULLISH");
+  });
+  it("score = 60 → STRONGLY_BULLISH", () => {
+    expect(bandFromScore(60).band).toBe("STRONGLY_BULLISH");
+  });
+  it("score = 100 → STRONGLY_BULLISH", () => {
+    expect(bandFromScore(100).band).toBe("STRONGLY_BULLISH");
+  });
+
+  it("label is human-readable for every band", () => {
+    expect(bandFromScore(-100).label).toBe("Strongly Bearish");
+    expect(bandFromScore(-30).label).toBe("Mildly Bearish");
+    expect(bandFromScore(0).label).toBe("Neutral");
+    expect(bandFromScore(30).label).toBe("Mildly Bullish");
+    expect(bandFromScore(100).label).toBe("Strongly Bullish");
+  });
+});
+
+// ─── scoreSentiment ─────────────────────────────────────────────────────────
+
+describe("scoreSentiment", () => {
+  it("baseline neutral inputs score 0", () => {
+    const s = scoreSentiment({
+      pcrOi: 1.0, spot: 100, maxPain: 100,
+      intradayFlow: 0,
+      topResistanceOi: 1000, topSupportOi: 1000,
+    });
+    expect(Math.abs(s)).toBeLessThanOrEqual(1); // rounding may shift by ±1
+  });
+
+  it("max-out bullish inputs cap near +100", () => {
+    const s = scoreSentiment({
+      pcrOi: 1.6, spot: 110, maxPain: 100,           // +25 PCR, +25 max-pain
+      intradayFlow: 1,                                 // +25 flow
+      topResistanceOi: 0, topSupportOi: 100_000,      // +25 cluster
+    });
+    expect(s).toBeGreaterThanOrEqual(99);
+    expect(s).toBeLessThanOrEqual(100);
+  });
+
+  it("max-out bearish inputs cap near -100", () => {
+    const s = scoreSentiment({
+      pcrOi: 0.4, spot: 90, maxPain: 100,
+      intradayFlow: -1,
+      topResistanceOi: 100_000, topSupportOi: 0,
+    });
+    expect(s).toBeLessThanOrEqual(-99);
+    expect(s).toBeGreaterThanOrEqual(-100);
+  });
+
+  it("PCR component clamps at the wings (PCR=2 contributes the same as PCR=1.6)", () => {
+    const a = scoreSentiment({ pcrOi: 1.6, spot: 100, maxPain: 100, intradayFlow: 0, topResistanceOi: 1, topSupportOi: 1 });
+    const b = scoreSentiment({ pcrOi: 5.0, spot: 100, maxPain: 100, intradayFlow: 0, topResistanceOi: 1, topSupportOi: 1 });
+    expect(a).toBe(b);
+  });
+
+  it("output is always in [-100, +100]", () => {
+    // Exhaustively sample a few extreme edges; rounding aside, no path should exit the range.
+    const cases = [
+      { pcrOi: 0.4, spot: 50, maxPain: 100, intradayFlow: -1, topResistanceOi: 1e7, topSupportOi: 0 },
+      { pcrOi: 1.6, spot: 200, maxPain: 100, intradayFlow: 1, topResistanceOi: 0, topSupportOi: 1e7 },
+      { pcrOi: 1.0, spot: 100, maxPain: 100, intradayFlow: 0, topResistanceOi: 0, topSupportOi: 0 },
+    ];
+    for (const c of cases) {
+      const s = scoreSentiment(c);
+      expect(s).toBeGreaterThanOrEqual(-100);
+      expect(s).toBeLessThanOrEqual(100);
+    }
+  });
+
+  it("zero cluster mass returns 0 cluster contribution (no NaN)", () => {
+    const s = scoreSentiment({
+      pcrOi: 1.0, spot: 100, maxPain: 100,
+      intradayFlow: 0,
+      topResistanceOi: 0, topSupportOi: 0,
+    });
+    expect(Number.isFinite(s)).toBe(true);
+  });
+});
+
+// ─── computeOiInsights ──────────────────────────────────────────────────────
+
+function makeRow(strike: number, ceOi: number, peOi: number, ceLtp = 100, peLtp = 100): OcRow {
+  return {
+    strike,
+    ce: { oi: ceOi, chgOi: 0, volume: 0, iv: 18, ltp: ceLtp },
+    pe: { oi: peOi, chgOi: 0, volume: 0, iv: 18, ltp: peLtp },
+  };
+}
+
+function makeChain(spot: number, atmStrike: number, rows: OcRow[], step = 50): OcResponse {
+  return {
+    underlying: "TEST",
+    underlyingName: "TEST",
+    kind: "INDEX",
+    spot,
+    prevClose: spot,
+    changePercent: 0,
+    expiry: "2026-05-30",
+    expiries: ["2026-05-30"],
+    atmStrike,
+    strikeStep: step,
+    lotSize: 75,
+    rows,
+    source: "test",
+    generatedAt: new Date().toISOString(),
+  };
+}
+
+describe("computeOiInsights – maxPain", () => {
+  it("max pain is the strike with minimum total writer pain", () => {
+    // Construct a chain where calls dominate at K=24600 (resistance), puts at
+    // K=24400 (support). Max pain should land at one of those two strikes
+    // (whichever yields the lowest total pain) — at the very least, NOT at
+    // the spot/ATM in a heavily skewed chain.
+    const rows: OcRow[] = [
+      makeRow(24300, 100, 5000),
+      makeRow(24350, 200, 8000),
+      makeRow(24400, 500, 12000), // heavy puts
+      makeRow(24450, 800, 4000),
+      makeRow(24500, 1000, 1000),
+      makeRow(24550, 4000, 800),
+      makeRow(24600, 12000, 500), // heavy calls
+      makeRow(24650, 8000, 200),
+      makeRow(24700, 5000, 100),
+    ];
+    const chain = makeChain(24500, 24500, rows);
+    const out = computeOiInsights(chain, 999);
+    expect(out.maxPain).toBeGreaterThanOrEqual(24400);
+    expect(out.maxPain).toBeLessThanOrEqual(24600);
+  });
+
+  it("maxPain on a perfectly symmetric chain ties at the centre and picks closest-to-spot", () => {
+    // Symmetric OI profile: every strike has the same call+put OI weight on the
+    // surrounding strikes, so several strikes share the minimum pain. The
+    // tie-break should pick the strike closest to spot.
+    const rows: OcRow[] = [
+      makeRow(24400, 1000, 1000),
+      makeRow(24450, 1000, 1000),
+      makeRow(24500, 1000, 1000),
+      makeRow(24550, 1000, 1000),
+      makeRow(24600, 1000, 1000),
+    ];
+    const chain = makeChain(24510, 24500, rows); // spot slightly above ATM
+    const out = computeOiInsights(chain, 999);
+    // Tied strikes near spot; closest-to-spot tie-break picks 24500 over 24450/24550.
+    expect([24500, 24550]).toContain(out.maxPain);
+  });
+});
+
+describe("computeOiInsights – PCR", () => {
+  it("pcrOi = 0 when total call OI is 0", () => {
+    const rows: OcRow[] = [makeRow(100, 0, 1000)];
+    const chain = makeChain(100, 100, rows);
+    const out = computeOiInsights(chain, 999);
+    expect(out.pcrOi).toBe(0);
+  });
+
+  it("pcrOi = total puts / total calls", () => {
+    const rows: OcRow[] = [
+      makeRow(100, 1000, 2000),
+      makeRow(110, 500,  1500),
+    ];
+    const chain = makeChain(105, 100, rows);
+    const out = computeOiInsights(chain, 999);
+    // 3500 / 1500 = 2.333
+    expect(out.pcrOi).toBeCloseTo(2.333, 2);
+  });
+});
+
+describe("computeOiInsights – intradayFlow polarity", () => {
+  it("equal absolute call/put accumulation → flow = 0", () => {
+    const rows: OcRow[] = [
+      { strike: 100, ce: { oi: 1000, chgOi: 500, volume: 0, iv: 18 }, pe: { oi: 1000, chgOi: 500, volume: 0, iv: 18 } },
+    ];
+    const chain = makeChain(100, 100, rows);
+    const out = computeOiInsights(chain, 999);
+    expect(out.intradayFlow).toBeCloseTo(0, 5);
+  });
+
+  it("only puts being added → flow = +1", () => {
+    const rows: OcRow[] = [
+      { strike: 100, ce: { oi: 1000, chgOi: 0,    volume: 0, iv: 18 }, pe: { oi: 1000, chgOi: 1000, volume: 0, iv: 18 } },
+    ];
+    const chain = makeChain(100, 100, rows);
+    const out = computeOiInsights(chain, 999);
+    expect(out.intradayFlow).toBeCloseTo(1, 5);
+  });
+
+  it("only calls being added → flow = -1", () => {
+    const rows: OcRow[] = [
+      { strike: 100, ce: { oi: 1000, chgOi: 1000, volume: 0, iv: 18 }, pe: { oi: 1000, chgOi: 0, volume: 0, iv: 18 } },
+    ];
+    const chain = makeChain(100, 100, rows);
+    const out = computeOiInsights(chain, 999);
+    expect(out.intradayFlow).toBeCloseTo(-1, 5);
+  });
+
