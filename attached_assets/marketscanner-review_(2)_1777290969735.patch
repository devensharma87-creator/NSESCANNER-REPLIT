+++ b/lib/db/src/schema/userSession.ts	2026-04-27 09:54:57.000000000 +0000
@@ -0,0 +1,33 @@
+import { pgTable, text, timestamp } from "drizzle-orm/pg-core";
+
+/**
+ * Per-session record for the SPA login flow.
+ *
+ * The cookie carries an opaque session ID (32 bytes hex, signed by the
+ * SESSION_SECRET cookie key). The actual session lifetime + last-seen-at are
+ * tracked here so that:
+ *
+ *  - Logout actually invalidates the cookie (we delete the row; subsequent
+ *    presentations of the same cookie ID find no row → 401).
+ *  - Sessions slide: every authenticated request bumps `lastSeenAt`, and
+ *    `expiresAt` is `lastSeenAt + 30d` so an active user is never logged out.
+ *  - Stale sessions can be reaped by a background job (`expiresAt < now()`).
+ *  - We can show "active sessions" in audit / system status panels.
+ *
+ * No PII: `password` is never stored anywhere (the app is single-tenant
+ * with one shared `APP_ACCESS_PASSWORD` env var). `ip` and `userAgent`
+ * are kept only for forensic value if a session is suspected of being
+ * stolen — they're truncated to plausible string lengths.
+ */
+export const userSessionTable = pgTable("user_session", {
+  id: text("id").primaryKey(),                                          // 64-char hex
+  csrfToken: text("csrf_token").notNull(),                              // double-submit token
+  createdAt: timestamp("created_at", { withTimezone: true }).notNull().defaultNow(),
+  lastSeenAt: timestamp("last_seen_at", { withTimezone: true }).notNull().defaultNow(),
+  expiresAt: timestamp("expires_at", { withTimezone: true }).notNull(),
+  ip: text("ip"),
+  userAgent: text("user_agent"),
+});
+
+export type UserSessionRow = typeof userSessionTable.$inferSelect;
+export type NewUserSessionRow = typeof userSessionTable.$inferInsert;
