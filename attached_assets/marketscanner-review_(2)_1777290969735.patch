diff -urN project/marketscanner-source/lib/api-client-react/src/custom-fetch.test.ts work/ms/lib/api-client-react/src/custom-fetch.test.ts
--- /dev/null
+++ b/lib/api-client-react/src/custom-fetch.test.ts	2026-04-27 09:54:02.000000000 +0000
@@ -0,0 +1,104 @@
+import { describe, it, expect, beforeEach, afterEach, vi } from "vitest";
+
+/**
+ * Tests for the customFetch credentials default.
+ *
+ * Why this matters: the orval-generated hooks call `customFetch()` without
+ * passing a `credentials` option. The web SPA needs `credentials: "include"`
+ * so the signed `scanner_session` cookie rides along on every request. Pre-fix,
+ * the field was never set, and the browser defaulted to "same-origin" — which
+ * silently 401s the moment the API and SPA are on different subdomains.
+ */
+
+describe("customFetch – credentials default", () => {
+  beforeEach(() => {
+    vi.resetModules();
+  });
+
+  afterEach(() => {
+    vi.restoreAllMocks();
+  });
+
+  it("sets credentials='include' by default", async () => {
+    const fetchSpy = vi.fn().mockResolvedValue(
+      new Response("{}", { status: 200, headers: { "content-type": "application/json" } }),
+    );
+    vi.stubGlobal("fetch", fetchSpy);
+
+    const { customFetch } = await import("./custom-fetch");
+    await customFetch("https://api.example.com/x");
+
+    expect(fetchSpy).toHaveBeenCalledTimes(1);
+    const init = fetchSpy.mock.calls[0][1] as RequestInit;
+    expect(init.credentials).toBe("include");
+  });
+
+  it("respects explicit credentials override", async () => {
+    const fetchSpy = vi.fn().mockResolvedValue(
+      new Response("{}", { status: 200, headers: { "content-type": "application/json" } }),
+    );
+    vi.stubGlobal("fetch", fetchSpy);
+
+    const { customFetch } = await import("./custom-fetch");
+    await customFetch("https://api.example.com/x", { credentials: "omit" });
+
+    const init = fetchSpy.mock.calls[0][1] as RequestInit;
+    expect(init.credentials).toBe("omit");
+  });
+
+  it("setCredentialsMode(null) disables setting the field", async () => {
+    const fetchSpy = vi.fn().mockResolvedValue(
+      new Response("{}", { status: 200, headers: { "content-type": "application/json" } }),
+    );
+    vi.stubGlobal("fetch", fetchSpy);
+
+    const mod = await import("./custom-fetch");
+    mod.setCredentialsMode(null);
+    await mod.customFetch("https://api.example.com/x");
+
+    const init = fetchSpy.mock.calls[0][1] as RequestInit;
+    expect(init.credentials).toBeUndefined();
+    // Reset back to default for downstream tests.
+    mod.setCredentialsMode("include");
+  });
+
+  it("setCredentialsMode('omit') overrides the default", async () => {
+    const fetchSpy = vi.fn().mockResolvedValue(
+      new Response("{}", { status: 200, headers: { "content-type": "application/json" } }),
+    );
+    vi.stubGlobal("fetch", fetchSpy);
+
+    const mod = await import("./custom-fetch");
+    mod.setCredentialsMode("omit");
+    await mod.customFetch("https://api.example.com/x");
+
+    const init = fetchSpy.mock.calls[0][1] as RequestInit;
+    expect(init.credentials).toBe("omit");
+    mod.setCredentialsMode("include");
+  });
+});
+
+describe("customFetch – ApiError shape", () => {
+  beforeEach(() => { vi.resetModules(); });
+  afterEach(() => { vi.restoreAllMocks(); });
+
+  it("throws ApiError on non-2xx with parsed JSON body", async () => {
+    // Use mockResolvedValue (returns same response every call) so the test
+    // can invoke customFetch twice without exhausting the mock.
+    const fetchSpy = vi.fn().mockImplementation(async () => new Response(
+      JSON.stringify({ error: "unauthorized", code: "AUTH_REQUIRED" }),
+      { status: 401, headers: { "content-type": "application/json" } },
+    ));
+    vi.stubGlobal("fetch", fetchSpy);
+
+    const { customFetch, ApiError } = await import("./custom-fetch");
+    await expect(customFetch("/api/x")).rejects.toBeInstanceOf(ApiError);
+    try {
+      await customFetch("/api/x");
+      expect.fail("should have thrown");
+    } catch (e) {
+      expect((e as InstanceType<typeof ApiError>).status).toBe(401);
+      expect((e as InstanceType<typeof ApiError>).data).toMatchObject({ error: "unauthorized" });
+    }
+  });
+});
