@@ -0,0 +1,362 @@
+import { describe, it, expect } from "vitest";
+import type { Indicators, Quote } from "@workspace/api-zod";
+import { buildRecommendation } from "./scoring";
+
+/**
+ * Tests for the scoring engine.
+ *
+ * Strategy: build a "synthetic" symbol with hand-tuned indicator values, push
+ * it through buildRecommendation, and assert on the resulting signal/score.
+ *
+ * Notable cases under test:
+ *   - Bullish full-stack: every rule should fire bullish → STRONG_BUY
+ *   - Bearish full-stack: every rule should fire bearish → STRONG_SELL
+ *   - Neutral / mixed evidence: NEUTRAL with score in [-22, +22]
+ *   - Stop-loss inversion guard (the bug fixed in the SL block — for a BUY
+ *     where support has drifted ABOVE price, SL must still be below price.)
+ *   - Missing-indicator handling: ADX/volRatio/deliveryPct null should
+ *     cause those rules to be skipped, NOT contribute fake "neutral" weight.
+ */
+
+// ─── Helpers ────────────────────────────────────────────────────────────────
+
+function makeQuote(overrides: Partial<Quote> = {}): Quote {
+  return {
+    symbol: "TEST",
+    name: "Test Co",
+    exchange: "NSE",
+    price: 100,
+    change: 1,
+    changePercent: 1,
+    open: 99,
+    high: 101,
+    low: 98.5,
+    previousClose: 99,
+    volume: 1_000_000,
+    avgVolume: 1_000_000,
+    fiftyTwoWeekHigh: 110,
+    fiftyTwoWeekLow: 80,
+    dayRange: "98.50 - 101.00",
+    yearRange: "80.00 - 110.00",
+    ...overrides,
+  } as Quote;
+}
+
+function makeIndicators(overrides: Partial<Indicators> = {}): Indicators {
+  return {
+    ema9: 99.5, ema21: 99, ema20: 99, ema50: 98, ema100: 97, ema200: 95,
+    vwap: 99,
+    rsi14: 60,
+    macd: 0.5, macdSignal: 0.4, macdHist: 0.1,
+    atr14: 1.5,
+    adx14: 28,
+    volumeRatio: 1.6,
+    deliveryPct: 65,
+    trendStrength: 70,
+    supportLevel: 95,
+    resistanceLevel: 105,
+    pivot: 100, r1: 102, s1: 98,
+    ...overrides,
+  } as Indicators;
+}
+
+function makeSeries(n: number, lastValue: number, slope: number = 0): (number | null)[] {
+  const out: (number | null)[] = [];
+  for (let i = 0; i < n; i++) out.push(lastValue - slope * (n - 1 - i));
+  return out;
+}
+
+function risingCloses(n: number = 60, start: number = 80, end: number = 100): number[] {
+  const out: number[] = [];
+  for (let i = 0; i < n; i++) out.push(start + ((end - start) * i) / (n - 1));
+  return out;
+}
+
+function fallingCloses(n: number = 60, start: number = 100, end: number = 80): number[] {
+  return risingCloses(n, start, end);
+}
+
+const baseInput = () => ({
+  quote: makeQuote(),
+  indicators: makeIndicators(),
+  closes: risingCloses(60, 80, 100),
+  ema9Series: makeSeries(60, 99.5, 0.05),
+  ema21Series: makeSeries(60, 99, 0.05),
+  ema20Series: makeSeries(60, 99, 0.05),
+  ema50Series: makeSeries(60, 98, 0.05),
+  rsiSeries: makeSeries(60, 60),
+  macdHistSeries: makeSeries(60, 0.1, 0.001),
+});
+
+// ─── Signal classification ──────────────────────────────────────────────────
+
+describe("buildRecommendation – signal classification", () => {
+  it("emits STRONG_BUY when every rule fires bullish", () => {
+    const r = buildRecommendation(baseInput());
+    expect(r.signal).toBe("STRONG_BUY");
+    expect(r.score).toBeGreaterThanOrEqual(50);
+    expect(r.score).toBeLessThanOrEqual(100);
+  });
+
+  it("emits STRONG_SELL when every rule fires bearish", () => {
+    const r = buildRecommendation({
+      ...baseInput(),
+      quote: makeQuote({ price: 80, change: -2, changePercent: -2.5, open: 82, high: 82, low: 80, previousClose: 82 }),
