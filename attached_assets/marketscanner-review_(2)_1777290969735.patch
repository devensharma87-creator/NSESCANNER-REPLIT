@@ -0,0 +1,103 @@
+import { describe, it, expect } from "vitest";
+import { __testing } from "./kiteAuth";
+
+const { next6amIST } = __testing;
+
+/**
+ * Tests for the next-6am-IST boundary.
+ *
+ * 06:00 IST = 00:30 UTC (IST is UTC+5:30). The function must:
+ *   - Return TODAY's 06:00 IST when called BEFORE 06:00 IST.
+ *   - Return TOMORROW's 06:00 IST when called AT or AFTER 06:00 IST.
+ *   - Always be strictly in the future (the token is dead at exactly 06:00).
+ *   - Handle the 23:30 UTC date-boundary correctly (~05:00 IST next day).
+ */
+
+function utcAt(year: number, month: number, day: number, hour: number, minute: number): Date {
+  return new Date(Date.UTC(year, month - 1, day, hour, minute, 0));
+}
+
+describe("next6amIST", () => {
+  it("called at 03:00 IST → returns today's 06:00 IST", () => {
+    // 03:00 IST on 2026-04-27 = 21:30 UTC on 2026-04-26.
+    const from = utcAt(2026, 4, 26, 21, 30);
+    const r = next6amIST(from);
+    // Today's 06:00 IST = 00:30 UTC on 2026-04-27.
+    expect(r.toISOString()).toBe("2026-04-27T00:30:00.000Z");
+  });
+
+  it("called at 05:59 IST → returns today's 06:00 IST", () => {
+    // 05:59 IST = 00:29 UTC.
+    const from = utcAt(2026, 4, 27, 0, 29);
+    const r = next6amIST(from);
+    expect(r.toISOString()).toBe("2026-04-27T00:30:00.000Z");
+  });
+
+  it("called at 06:00 IST exactly → rolls to TOMORROW's 06:00 IST", () => {
+    // 06:00 IST = 00:30 UTC. The token is dead at this exact moment, so
+    // we never want expiresAt = now — we always roll forward.
+    const from = utcAt(2026, 4, 27, 0, 30);
+    const r = next6amIST(from);
+    expect(r.toISOString()).toBe("2026-04-28T00:30:00.000Z");
+  });
+
+  it("called at 09:00 IST → returns TOMORROW's 06:00 IST", () => {
+    // 09:00 IST = 03:30 UTC.
+    const from = utcAt(2026, 4, 27, 3, 30);
+    const r = next6amIST(from);
+    expect(r.toISOString()).toBe("2026-04-28T00:30:00.000Z");
+  });
+
+  it("called at 23:00 IST → returns TOMORROW's 06:00 IST", () => {
+    // 23:00 IST on 2026-04-27 = 17:30 UTC on 2026-04-27.
+    const from = utcAt(2026, 4, 27, 17, 30);
+    const r = next6amIST(from);
+    expect(r.toISOString()).toBe("2026-04-28T00:30:00.000Z");
+  });
+
+  it("handles UTC midnight that's already past 06:00 IST in IST date", () => {
+    // 00:00 UTC = 05:30 IST on the same UTC calendar day. So at this moment
+    // we're at 05:30 IST and expect today's 06:00 IST (in 30 minutes).
+    const from = utcAt(2026, 4, 27, 0, 0);
+    const r = next6amIST(from);
+    // 06:00 IST on 2026-04-27 = 00:30 UTC same day.
+    expect(r.toISOString()).toBe("2026-04-27T00:30:00.000Z");
+  });
+
+  it("handles late-UTC times correctly (IST is on the next calendar day)", () => {
+    // 22:00 UTC on 2026-04-27 = 03:30 IST on 2026-04-28. Next 06:00 IST is
+    // therefore 06:00 IST on 2026-04-28 = 00:30 UTC on 2026-04-28.
+    const from = utcAt(2026, 4, 27, 22, 0);
+    const r = next6amIST(from);
+    expect(r.toISOString()).toBe("2026-04-28T00:30:00.000Z");
+  });
+
+  it("returns a strictly-future timestamp for any input", () => {
+    // Sample a handful of times and verify the strict-future property.
+    const samples = [
+      utcAt(2026, 1, 1, 0, 0),
+      utcAt(2026, 6, 30, 12, 0),
+      utcAt(2026, 12, 31, 23, 59),
+      utcAt(2026, 4, 27, 0, 30), // exactly 06:00 IST
+    ];
+    for (const from of samples) {
+      const r = next6amIST(from);
+      expect(r.getTime()).toBeGreaterThan(from.getTime());
+    }
+  });
+
+  it("returns a value at most 24 hours away", () => {
+    // The next 06:00 IST is always within a 24-hour window.
+    const samples = [
+      utcAt(2026, 4, 27, 0, 0),
+      utcAt(2026, 4, 27, 12, 0),
+      utcAt(2026, 4, 27, 23, 30),
+    ];
+    for (const from of samples) {
+      const r = next6amIST(from);
+      const diffHours = (r.getTime() - from.getTime()) / (3600 * 1000);
+      expect(diffHours).toBeGreaterThan(0);
+      expect(diffHours).toBeLessThanOrEqual(24);
+    }
+  });
+});
