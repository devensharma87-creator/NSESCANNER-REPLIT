//@version=5
// =============================================================================
// Unified Intraday F&O STRATEGY v1  —  ORB + VWAP + EMA Pullback
// For Nifty 50, Bank Nifty, Sensex (Indian index F&O, intraday)
// Backtestable via TradingView Strategy Tester (win-rate, P&L, drawdown).
// Confluence threshold is configurable (1 / 2 / 3 of ORB+VWAP+EMA).
// NOTE: Educational / research tool. Not investment advice. Use a hard SL.
// =============================================================================
strategy("Unified Intraday F&O Strategy v1", overlay=true,
     default_qty_type=strategy.fixed, default_qty_value=1,
     initial_capital=200000, commission_type=strategy.commission.cash_per_order,
     commission_value=20, calc_on_every_tick=false, process_orders_on_close=true,
     max_labels_count=500)

// ---------------- Inputs ----------------
grpIdx   = "Index Selection"
idxMode  = input.string("Auto", "Index parameter set", options=["Auto","Nifty","BankNifty","Sensex"], group=grpIdx)

grpOR    = "Opening Range"
orMins   = input.int(15, "Opening Range minutes", minval=5, maxval=60, group=grpOR)
sessStart= input.session("0915-1530", "Session", group=grpOR)

grpEnt   = "Entry / Filters"
minScore = input.int(2, "Confluence threshold (of 3)", minval=1, maxval=3, group=grpEnt, tooltip="How many of ORB / VWAP / EMA must agree. 3 = strictest.")
rsiLen   = input.int(14, "RSI length", group=grpEnt)
rsiLong  = input.int(55, "RSI long threshold", group=grpEnt)
rsiShort = input.int(45, "RSI short threshold", group=grpEnt)
useRsi   = input.bool(true, "Use RSI momentum filter", group=grpEnt)
noTradeLunch = input.bool(true, "Block 12:00-13:30 entries", group=grpEnt)

grpExit  = "Risk"
atrLen   = input.int(14, "ATR length", group=grpExit)
rMultTP  = input.float(1.5, "Target (R multiple)", step=0.1, group=grpExit)
useTimeStop = input.bool(true, "Close all at 15:00", group=grpExit)

// ---------------- Index-aware parameter set ----------------
sym = syminfo.ticker
isBN  = idxMode=="BankNifty" or (idxMode=="Auto" and (str.contains(sym,"BANKNIFTY") or str.contains(sym,"BANKNIF")))
isSX  = idxMode=="Sensex"    or (idxMode=="Auto" and str.contains(sym,"SENSEX"))
isNF  = not isBN and not isSX

atrMult = isBN ? 1.3 : isSX ? 1.2 : 1.0
buffer  = isBN ? 30.0 : isSX ? 30.0 : 10.0

// ---------------- Core indicators ----------------
ema9   = ta.ema(close, 9)
ema21  = ta.ema(close, 21)
vwapV  = ta.vwap(hlc3)
rsiV   = ta.rsi(close, rsiLen)
atrV   = ta.atr(atrLen)

// ---------------- Session & Opening Range ----------------
inSession = not na(time(timeframe.period, sessStart))
isNewDay  = ta.change(time("D")) != 0

var float orHigh = na
var float orLow  = na
var int   orEndT = na
var bool  orDone = false

if isNewDay
    orHigh := high
    orLow  := low
    orEndT := time + orMins * 60 * 1000
    orDone := false
else if inSession and not orDone
    if time < orEndT
        orHigh := math.max(orHigh, high)
        orLow  := math.min(orLow, low)
    else
        orDone := true

plot(orDone ? orHigh : na, "OR High", color=color.new(color.gray,30), style=plot.style_linebr)
plot(orDone ? orLow  : na, "OR Low",  color=color.new(color.gray,30), style=plot.style_linebr)
plot(vwapV, "VWAP", color=color.new(color.orange,0), linewidth=2)
plot(ema9,  "EMA9",  color=color.new(color.aqua,0))
plot(ema21, "EMA21", color=color.new(color.fuchsia,0))

// ---------------- Time filters ----------------
hr = hour(time, syminfo.timezone)
mn = minute(time, syminfo.timezone)
curMin = hr*60 + mn
inLunch = noTradeLunch and (curMin >= 720 and curMin <= 810)
afterTimeStop = useTimeStop and (curMin >= 900)

// ---------------- Signal components ----------------
aboveVWAP = close > vwapV
belowVWAP = close < vwapV
emaUp     = ema9 > ema21
emaDn     = ema9 < ema21
orbLong   = orDone and close > orHigh + buffer
orbShort  = orDone and close < orLow  - buffer
pbLong    = emaUp and low <= ema21 and close > ema21 and close > open
pbShort   = emaDn and high >= ema21 and close < ema21 and close < open
rsiOkL    = not useRsi or rsiV > rsiLong
rsiOkS    = not useRsi or rsiV < rsiShort

longScore  = (orbLong?1:0) + (aboveVWAP?1:0) + ((emaUp or pbLong)?1:0)
shortScore = (orbShort?1:0)+ (belowVWAP?1:0) + ((emaDn or pbShort)?1:0)

canTrade = orDone and inSession and not inLunch and not afterTimeStop
longSig  = canTrade and longScore  >= minScore and rsiOkL
shortSig = canTrade and shortScore >= minScore and rsiOkS

// ---------------- SL / TP ----------------
slLongPx  = close - atrV * atrMult
slShortPx = close + atrV * atrMult
riskL     = atrV * atrMult
tpLongPx  = close + riskL * rMultTP
tpShortPx = close - riskL * rMultTP

// ---------------- Strategy execution ----------------
flat = strategy.position_size == 0

if longSig and flat
    strategy.entry("L", strategy.long)
    strategy.exit("L-x", from_entry="L", stop=slLongPx, limit=tpLongPx)

if shortSig and flat
    strategy.entry("S", strategy.short)
    strategy.exit("S-x", from_entry="S", stop=slShortPx, limit=tpShortPx)

// Hard square-off at time stop / session end
if afterTimeStop and not flat
    strategy.close_all(comment="TimeStop")

// ---------------- Info table ----------------
var table t = table.new(position.top_right, 2, 4, border_width=1)
if barstate.islast
    idxName = isBN ? "BankNifty" : isSX ? "Sensex" : "Nifty"
    table.cell(t, 0, 0, "Index set", text_color=color.white, bgcolor=color.new(color.blue,0))
    table.cell(t, 1, 0, idxName,     text_color=color.white, bgcolor=color.new(color.blue,40))
    table.cell(t, 0, 1, "ATR x | Buf", text_color=color.white, bgcolor=color.new(color.gray,30))
    table.cell(t, 1, 1, str.tostring(atrMult)+" | "+str.tostring(buffer), text_color=color.white, bgcolor=color.new(color.gray,60))
    table.cell(t, 0, 2, "Confluence", text_color=color.white, bgcolor=color.new(color.gray,30))
    table.cell(t, 1, 2, str.tostring(minScore)+"/3", text_color=color.white, bgcolor=color.new(color.gray,60))
    table.cell(t, 0, 3, "Win rate", text_color=color.white, bgcolor=color.new(color.green,30))
    wr = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100 : 0.0
    table.cell(t, 1, 3, str.tostring(wr, "#.0")+"%", text_color=color.white, bgcolor=color.new(color.green,60))
